  defaultControls:
  - key: W / A / S / D
    description: Move up / left / down / right
  - key: Space
    description: Wait (skip 1 turn)
  - key: Enter / Tab / Q
    description: End Loop Early (fast-forwards turns)
  - key: E
    description: Collect item (weapon or potion)
  - key: X / F
    description: Attack enemy (when weapon equipped)
  - key: R
    description: Restart level (from loop 1)
  - key: Esc
    description: Close help popup
